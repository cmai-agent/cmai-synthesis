#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILL_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
REPO_ROOT="$(cd "$SKILL_DIR/../.." && pwd)"
TOOL_DIR="$REPO_ROOT/tools/openai-image-batch"
DEFAULT_TEMPLATE="$SKILL_DIR/nft-template.txt"

if [ ! -f "$TOOL_DIR/generate-images.mjs" ]; then
  echo "Missing OpenAI image tool at $TOOL_DIR" >&2
  exit 1
fi

if [ ! -d "$TOOL_DIR/node_modules/openai" ]; then
  echo "Installing dependencies for openai-image-batch..." >&2
  (
    cd "$TOOL_DIR"
    npm install
  )
fi

has_reference=0
has_template=0
has_output_dir=0

for arg in "$@"; do
  case "$arg" in
    --reference|--use-default-reference)
      has_reference=1
      ;;
    --template|--template-file)
      has_template=1
      ;;
    --output-dir)
      has_output_dir=1
      ;;
  esac
done

args=("$@")

if [ "$has_reference" -eq 0 ]; then
  args+=(--use-default-reference)
fi

if [ "$has_template" -eq 0 ]; then
  args+=(--template-file "$DEFAULT_TEMPLATE")
fi

if [ "$has_output_dir" -eq 0 ]; then
  timestamp="$(date +%Y%m%d-%H%M%S)"
  args+=(--output-dir "$REPO_ROOT/output/generate-nft-images/$timestamp")
fi

(
  cd "$TOOL_DIR"
  node generate-images.mjs "${args[@]}"
)
